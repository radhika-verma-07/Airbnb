<% if (errors.length > 0) { %>
  <div class="col-span-2 *:bg-rose-50 rounded-xl border border-rose-200 p-4">
    <ul class="space-y-2 text-sm text-rose-500">
      <strong class="block text-rose-700">Please fix the following errors:</strong>
      <span class="block sn:inline">
      <% errors.forEach(error => { %>
        <li><%= error %></li>
      <% }); %>
      </span>
    </ul>
  </div>
<% } %>


