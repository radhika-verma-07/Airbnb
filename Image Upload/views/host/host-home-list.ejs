<%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/nav') %>
  <main class="container mx-auto mt-10 max-w-7xl px-4">
    <h2 class="text-3xl sm:text-4xl text-gray-800 font-extrabold text-center mb-8">
      Hey Host! Here are your homes:
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 mb-8">

  <% registeredHomes.forEach(home => { %>

    <div class="bg-white rounded-lg shadow-lg overflow-hidden">

      <img
      src="<%= home.photo %>"
      alt="<%= home.houseName %>"
      class="w-full h-48 object-cover"/>

      <div class="p-4">

        <h3 class="text-xl font-semibold">
          <%= home.houseName %>
        </h3>

        <p><%= home.location %></p>

        <div class="flex justify-between items-center mt-3">

          <span class="text-red-600 font-bold">
            Rs <%= home.price %> / night
          </span>

          <span>
            ⭐ <%= home.rating %>
          </span>

        </div>
        <a href="/host/edit-home/<%= home._id %>" class="bg-blue-500 font-bold py-1.5 px-4 rounded">Edit</a> 
        <form action="/host/delete-home/<%= home._id %>" method="POST">
          <button type="submit" class="bg-red-500 font-bold py-1.5 px-4 rounded">Delete</button>
        </form>
      </div>
    </div>
  <% }) %>
</div>

