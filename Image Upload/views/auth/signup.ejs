<%- include('../partials/head') %>
<body class="min-h-screen overflow-x-hidden bg-slate-950 text-slate-900">
  <%- include('../partials/nav') %>
  <main class="relative flex min-h-[calc(100vh-4rem)] items-center justify-center overflow-hidden px-4 py-10 sm:px-6">
    <div class="pointer-events-none absolute -left-32 top-8 h-80 w-80 rounded-full bg-rose-500/30 blur-3xl"></div>
    <div class="pointer-events-none absolute -right-24 bottom-0 h-96 w-96 rounded-full bg-orange-400/20 blur-3xl"></div>

    <section class="relative grid w-full max-w-5xl overflow-hidden rounded-[2rem] bg-white shadow-2xl shadow-black/30 lg:grid-cols-[0.85fr_1.15fr]">
      <div class="relative hidden overflow-hidden bg-gradient-to-br from-rose-600 via-pink-600 to-orange-500 p-10 text-white lg:flex lg:flex-col lg:justify-between">
        <div class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full border-[32px] border-white/10"></div>
        <div class="pointer-events-none absolute -bottom-24 -left-20 h-72 w-72 rounded-full border-[40px] border-white/10"></div>
        <div class="relative">
          <div class="mb-8 flex h-14 w-14 items-center justify-center rounded-2xl bg-white/15 text-2xl shadow-lg ring-1 ring-white/20">⌂</div>
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-rose-100">Your next escape</p>
          <h2 class="mt-4 text-4xl font-extrabold leading-tight">Make room for more memorable stays.</h2>
          <p class="mt-5 max-w-sm leading-7 text-rose-50">Find a place that feels like yours, or share a space guests will never forget.</p>
        </div>
        <p class="relative text-sm font-medium text-rose-100">Simple stays. Lasting memories.</p>
      </div>

      <div class="p-6 sm:p-10 lg:p-12">
        <div class="mb-8">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-rose-500">Welcome to airbnb</p>
          <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Create your account</h1>
          <p class="mt-3 text-slate-500">Join us and discover your perfect stay.</p>
        </div>

        <form action="/signup" method="POST" class="space-y-5">
          <%- include('../partials/errors') %>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="firstName" class="mb-2 block text-sm font-semibold text-slate-700">First name</label>
              <input id="firstName" type="text" name="firstName" autocomplete="given-name" placeholder="Alex" value="<%= oldInput.firstName ? oldInput.firstName : '' %>" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3.5 outline-none transition focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100" required/>
            </div>
            <div>
              <label for="lastName" class="mb-2 block text-sm font-semibold text-slate-700">Last name <span class="font-normal text-slate-400">(optional)</span></label>
              <input id="lastName" type="text" name="lastName" autocomplete="family-name" placeholder="Morgan" value="<%= oldInput.lastName ? oldInput.lastName : '' %>" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3.5 outline-none transition focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100"/>
            </div>
          </div>
          <div>
            <label for="email" class="mb-2 block text-sm font-semibold text-slate-700">Email address</label>
            <input id="email" type="email" name="email" autocomplete="email" placeholder="you@example.com" value="<%= oldInput.email ? oldInput.email : '' %>" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3.5 outline-none transition focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100" required/>
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="password" class="mb-2 block text-sm font-semibold text-slate-700">Password</label>
              <input id="password" type="password" name="password" autocomplete="new-password" placeholder="Create a password" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3.5 outline-none transition focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100" required/>
            </div>
            <div>
              <label for="confirmPassword" class="mb-2 block text-sm font-semibold text-slate-700">Confirm password</label>
              <input id="confirmPassword" type="password" name="confirmPassword" autocomplete="new-password" placeholder="Repeat your password" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3.5 outline-none transition focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100" required/>
            </div>
          </div>

          <fieldset class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <legend class="px-1 text-sm font-semibold text-slate-700">I want to join as</legend>
            <div class="mt-3 grid grid-cols-2 gap-3">
              <label class="flex cursor-pointer items-center rounded-xl border border-rose-200 bg-white px-3 py-3 text-sm font-semibold text-slate-700 transition hover:border-rose-400">
                <input type="radio" name="userType" value="guest" id="guest" class="mr-2 accent-rose-500" checked="<% oldInput.userType === "guest" %>" />Guest
              </label>
              <label class="flex cursor-pointer items-center rounded-xl border border-transparent bg-white px-3 py-3 text-sm font-semibold text-slate-700 transition hover:border-rose-400">
                <input type="radio" name="userType" value="host" id="host" class="mr-2 accent-rose-500" checked="<% oldInput.userType === "host" %>" />Host
              </label>
            </div>
          </fieldset>

          <label for="terms" class="flex cursor-pointer items-start gap-3 text-sm leading-6 text-slate-500">
            <input type="checkbox" name="terms" id="terms" class="mt-1 shrink-0 accent-rose-500" required/>
            <span>I agree to the <a href="#" class="font-semibold text-rose-500 hover:text-rose-700">terms and conditions</a>.</span>
          </label>

          <button type="submit" class="w-full cursor-pointer rounded-xl bg-gradient-to-r from-rose-600 to-orange-500 py-3.5 font-bold text-white shadow-lg shadow-rose-500/25 transition duration-300 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-rose-500/30 focus:outline-none focus:ring-4 focus:ring-rose-200">Create account</button>
          <p class="text-center text-sm text-slate-500">Already have an account? <a href="/login" class="font-bold text-rose-500 transition hover:text-rose-700">Log in</a></p>
        </form>
      </div>
    </section>
  </main>
</body>
</html>