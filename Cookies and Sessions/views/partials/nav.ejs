<header class="bg-red-600 text-white shadow">
  <nav class="container mx-auto px-4 py-4 flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <span class="font-extrabold text-lg tracking-tight">airbnb</span>
      <span class="hidden sm:inline text-sm text-red-100">
        Find and book unique homes
      </span>
    </div>

    <ul class="flex items-center space-x-3">
      <li>
        <a
          href="/"
          class="<%= currentPage === 'home' ? 'bg-white/20' : 'hover:bg-white/20' %> text-white py-2 px-4 rounded-md transition">
          Airbnb Home
        </a>
      </li>
      <% if (isLoggedIn) { %>
        <li>
          <a
            href="/homes"
            class="<%= currentPage === 'homes' ? 'bg-white/20' : 'hover:bg-white/20' %> text-white py-2 px-4 rounded-md transition">
            Homes-list
          </a>
        </li>

        <li>
          <a
            href="/favourites"
            class="<%= currentPage === 'favourites' ? 'bg-white/20' : 'hover:bg-white/20' %> text-white py-2 px-4 rounded-md transition">
            Favourites
          </a>
        </li>

        <li>
          <a
            href="/bookings"
            class="<%= currentPage === 'bookings' ? 'bg-white/20' : 'hover:bg-white/20' %> text-white py-2 px-4 rounded-md transition">
            Bookings
          </a>
        </li>

        <li>
          <a
            href="/host/host-home-list"
            class="<%= currentPage === 'host-homes' ? 'bg-white/20' : 'hover:bg-white/20' %> text-white py-2 px-4 rounded-md transition">
            Host Homes
          </a>
        </li>

        <li>
          <a
            href="/host/add-home"
            class="<%= currentPage === 'addHome' ? 'bg-white/20' : 'hover:bg-white/20' %> text-white py-2 px-4 rounded-md transition">
            Add Home
          </a>
        </li>
      <% } %>


      <!-- LOGIN BUTTON -->
      <li>
        <% if (!isLoggedIn) { %>
          <a
            href="/login"
            class="bg-white text-red-600 py-2 px-4 rounded-md hover:bg-gray-100 transition font-semibold">
            Login
          </a>
        <% } else { %>
          <form action="/logout" method="POST">
            <button
              type="submit"
              class="bg-white text-red-600 py-2 px-4 rounded-md hover:bg-gray-100 transition font-semibold">
              Logout
            </button>
          </form>
        <% } %>
      </li>
    </ul>
  </nav>
</header>
